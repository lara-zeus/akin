{
    "name": "lara-zeus/akin",
    "description": "Lara-zeus Akin، telling a story with a design ... another filament theme.",
    "keywords": [
        "laravel",
        "lara-zeus",
        "akin",
        "sky",
        "theme",
        "artemis",
        "filamentphp"
    ],
    "homepage": "https://larazeus.com/akin",
    "support": {
        "issues": "https://github.com/lara-zeus/akin/issues",
        "source": "https://github.com/lara-zeus/akin"
    },
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Lara Zeus",
            "email": "info@larazeus.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.19",
        "lara-zeus/tabler-icons-enum": "^1.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "larastan/larastan": "^2.0.1",
        "orchestra/testbench": "^9.0",
        "phpstan/extension-installer": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "LaraZeus\\Akin\\": "src"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaraZeus\\Akin\\AkinServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
